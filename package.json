{
  "name": "ebj-website",
  "version": "1.0.0",
  "description": "Static website for Eco Brand Japan",
  "scripts": {
    "build": "npm run build:client && npm run build:static",
    "build:static": "node tools/build-static-assets.mjs",
    "build:social-preview": "node tools/build-static-assets.mjs --social-preview",
    "build:client": "node tools/build-client-js.mjs",
    "test": "node test.js && node --test tools/test-worker.mjs",
    "optimize:images": "node tools/optimize-images.mjs",
    "optimize:images:dry": "node tools/optimize-images.mjs --dry-run"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.4"
  }
}
